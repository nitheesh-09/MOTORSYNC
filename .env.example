# MOTORSYNC Environment Configuration Template

# Server Port
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Persistent Storage
DATABASE_PATH=./data/motorsync.db

# Ingestion Source ('SYNTHETIC' or 'EXTERNAL_LAPTOP')
DATA_SOURCE=SYNTHETIC

# AI Diagnostic Model
AI_MODEL=experimental-v0.1

# Logging Level ('debug', 'info', 'warn', 'error')
LOG_LEVEL=info

# Upload Limit (MB)
UPLOAD_LIMIT_MB=50
